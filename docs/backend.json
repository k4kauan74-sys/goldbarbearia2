
{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "type": "object",
      "description": "Usuário administrativo.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "type": "object",
      "description": "Perfil do cliente assinante.",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "cpf": { "type": "string" },
        "plan": { "type": "string", "enum": ["mensal", "trimestral", "semestral", null] },
        "planType": { "type": "string", "enum": ["basico", "gold", null] },
        "subscriptionStatus": { "type": "string", "enum": ["ativa", "inativa", "pendente"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "cpf", "subscriptionStatus"]
    },
    "Professional": {
      "title": "Professional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "specialty", "isActive"]
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientId": { "type": "string" },
        "serviceId": { "type": "string" },
        "professionalId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string", "format": "time" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientName", "clientId", "serviceId", "professionalId", "date", "time", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/admin_roles/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Papéis administrativos."
    },
    "/clients/{uid}": {
      "schema": { "$ref": "#/entities/ClientProfile" },
      "description": "Dados do cliente e assinatura."
    },
    "/professionals/{professionalId}": {
      "schema": { "$ref": "#/entities/Professional" },
      "description": "Lista de barbeiros."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Serviços disponíveis."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Agendamentos realizados."
    }
  }
}
