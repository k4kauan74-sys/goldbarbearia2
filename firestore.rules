
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // Para o protótipo: simplificamos isAdmin para permitir que o usuário autenticado (mesmo anônimo)
    // gerencie o sistema através do painel administrativo. 
    // Em uma aplicação real, isso seria restrito a uids específicos ou custom claims.
    function isAdmin() { 
      return isSignedIn(); 
    }
    
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /admin_roles/{adminUid} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    match /clients/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus', 'expiresAt', 'plan', 'planType']));
      allow delete: if isAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
      // Permite leitura para verificação de disponibilidade e visualização no dashboard
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
  }
}
